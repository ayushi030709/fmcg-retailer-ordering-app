# Copy to backend/.env and fill in local values. Never commit real secrets.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://fmcg:fmcg@localhost:5432/fmcg_dev
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_EXPIRES_MINUTES=720
# Comma-separated browser origins allowed by CORS
FRONTEND_ORIGIN=http://localhost:5173

# Demo OTP: no SMS is sent; reviewers sign in with DEMO_OTP. Set DEMO_MODE=false only with a real SMS provider.
DEMO_MODE=true
DEMO_OTP=123456

# AI provider (OpenAI-compatible chat completions; Groq by default).
# Leave AI_PROVIDER_API_KEY empty to use the clearly-labelled rule-based fallback parser.
AI_PROVIDER=groq
AI_PROVIDER_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
AI_BASE_URL=https://api.groq.com/openai/v1
AI_TIMEOUT_SECONDS=20
